{
  "name": "reveo-flow",
  "version": "1.0.1",
  "private": true,
  "description": "FlowGraph Video Workflow desktop app",
  "author": "Rocket Global",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyengiadat03/reveo-flow.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "release:win": "npm run dist",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:push": "supabase db push"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.4",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "supabase": "^2.101.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.rocketglobal.flowgraph",
    "productName": "Video Flow",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-updater/node_modules/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/universalify/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/argparse/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/semver/**/*",
      "node_modules/debug/**/*",
      "node_modules/sax/**/*",
      "node_modules/ffmpeg-static/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Video-Flow-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Video-Flow-Portable-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nguyengiadat03",
        "repo": "reveo-flow",
        "releaseType": "release"
      }
    ]
  }
}
